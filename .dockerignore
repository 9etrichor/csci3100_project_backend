# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class

# Ignore environment files
.env
.env.local

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore logs
*.log

# Ignore database files
db.sqlite3

# Ignore collected static files
staticfiles/
static/

# Ignore media files
media/

# Ignore test coverage
.coverage
htmlcov/

# Ignore node modules (if any)
node_modules/

# Ignore temporary files
*.tmp
*.temp
